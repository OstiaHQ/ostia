{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "pixi",
    "custom.regex"
  ],
  "labels": [
    "component: build"
  ],
  "commitMessagePrefix": "📦️ build(deps):",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{depName}}",
  "semanticCommits": "disabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "CPM pins in the ostia_cpm_add form (RFC-0001 §2.4); `ostia-dev check cpm-pins` enforces it",
      "managerFilePatterns": [
        "/(^|/)cmake/[^/]+\\.cmake$/",
        "/(^|/)CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "GITHUB_REPOSITORY\\s+(?<depName>\\S+)\\s+VERSION\\s+(?<currentValue>\\S+)\\s+GIT_TAG\\s+(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "The remote-run image in ostia-dev's profiles.toml (RFC-0005 §4.5), pinned by digest",
      "managerFilePatterns": [
        "/(^|/)tools/ostia-dev/src/ostia_dev/remote/profiles\\.toml$/"
      ],
      "matchStrings": [
        "image = \"(?<depName>ghcr\\.io/prefix-dev/pixi):(?<currentValue>[0-9.]+-noble)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The pixi version setup-pixi installs in CI (RFC-0001 §4.1)",
      "managerFilePatterns": [
        "/(^|/)\\.github/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "pixi-version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "prefix-dev/pixi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "The minimum pixi version in pixi.toml",
      "managerFilePatterns": [
        "/(^|/)pixi\\.toml$/"
      ],
      "matchStrings": [
        "requires-pixi = \">=(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "prefix-dev/pixi",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>\\d+\\.\\d+)",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "description": "The pinned official kubectl for remote k8s runs (RFC-0005 §4.1)",
      "managerFilePatterns": [
        "/(^|/)tools/ostia-dev/src/ostia_dev/remote/k8s/kubectl\\.toml$/"
      ],
      "matchStrings": [
        "version = \"(?<currentValue>v[0-9.]+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The kind node image of remote.yml's kind job (RFC-0005 Testing)",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/remote\\.yml$/"
      ],
      "matchStrings": [
        "KIND_NODE: (?<depName>kindest/node):(?<currentValue>v[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "The pixi image, CI's pixi and requires-pixi move together (RFC-0005 §4.5)",
      "matchDepNames": [
        "ghcr.io/prefix-dev/pixi",
        "prefix-dev/pixi"
      ],
      "groupName": "pixi"
    },
    {
      "description": "kubectl: patch releases of the pinned minor only (a minor bump is by hand); refill the sha256 table after each bump",
      "matchDepNames": [
        "kubernetes/kubernetes"
      ],
      "allowedVersions": "/^v1\\.36\\./",
      "postUpgradeTasks": {
        "commands": [
          "pixi run ostia-dev remote k8s kubectl --update-shas"
        ],
        "fileFilters": [
          "tools/ostia-dev/src/ostia_dev/remote/k8s/kubectl.toml"
        ],
        "executionMode": "update"
      }
    }
  ]
}
