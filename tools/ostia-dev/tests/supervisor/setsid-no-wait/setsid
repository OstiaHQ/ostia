#!/usr/bin/env python3
"""A setsid like busybox's applet: `setsid [-c] prog args...`, and no -w (it prints usage)."""

import os
import sys

args = sys.argv[1:]
if args and args[0].startswith("-") and args[0] != "-c":
    print("Usage: setsid [-c] PROG ARGS", file=sys.stderr)
    sys.exit(1)
if args and args[0] == "-c":
    args = args[1:]
os.setsid()
os.execvp(args[0], args)
