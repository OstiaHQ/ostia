{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OstiaHQ/ostia/tools/bench/schema-v1.json",
  "title": "Ostia benchmark result, schema 1 (RFC-0001 §6.2)",
  "type": "object",
  "required": ["schema", "provenance", "compat", "bench", "params", "unit", "higher_is_better", "samples"],
  "properties": {
    "schema": { "const": 1 },
    "provenance": {
      "type": "object",
      "required": ["git_sha", "date", "run_id"],
      "properties": {
        "git_sha": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" }
      }
    },
    "compat": {
      "type": "object",
      "required": ["gpu", "driver", "cuda", "nic", "topology", "build_level", "compiler", "deps"],
      "properties": {
        "topology": { "type": ["string", "null"], "description": "RFC-0003 topo1 identity; null before fixtures land" }
      }
    },
    "bench": { "type": "string" },
    "params": { "type": "object" },
    "unit": { "type": "string" },
    "higher_is_better": { "type": "boolean" },
    "samples": { "type": "array", "minItems": 1, "items": { "type": "number" } },
    "median": { "type": "number" },
    "p5": { "type": "number" },
    "p95": { "type": "number" }
  }
}
