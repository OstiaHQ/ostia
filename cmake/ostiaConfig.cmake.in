# Package config for an installed Ostia (RFC-0001 §3.2):
#   find_package(ostia COMPONENTS fabric)   # links ostia::fabric (and loads telemetry)
# Placeholders are never installed; asking for one fails with a pointer to its RFC (§3.1).
@PACKAGE_INIT@

# The telemetry flavour this installed stack was built with (RFC-0001 §5).
set(ostia_TELEMETRY "@OSTIA_TELEMETRY@")
set(ostia_TELEMETRY_LEVEL @OSTIA_TELEMETRY_LEVEL@)

set(_ostia_real @OSTIA_REAL_COMPONENTS@)
set(_ostia_placeholders @OSTIA_PLACEHOLDER_COMPONENTS@)
@OSTIA_CONFIG_DEPS@
@OSTIA_CONFIG_RFCS@
set(_ostia_loaded "")

# Loads a component's targets after those of its dependencies, each once.
function(_ostia_load c)
  if(c IN_LIST _ostia_loaded)
    return()
  endif()
  foreach(d IN LISTS _ostia_deps_${c})
    _ostia_load(${d})
  endforeach()
  include("${CMAKE_CURRENT_LIST_DIR}/ostia-${c}-targets.cmake")
  list(APPEND _ostia_loaded ${c})
  set(_ostia_loaded "${_ostia_loaded}" PARENT_SCOPE)
endfunction()

set(_ostia_want ${ostia_FIND_COMPONENTS})
if(NOT _ostia_want)
  foreach(c IN LISTS _ostia_real)
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/ostia-${c}-targets.cmake")
      list(APPEND _ostia_want ${c})
    endif()
  endforeach()
endif()
foreach(c IN LISTS _ostia_want)
  if(c IN_LIST _ostia_placeholders)
    set(ostia_FOUND FALSE)
    set(ostia_NOT_FOUND_MESSAGE " error: ostia component '${c}' is a placeholder with no API yet\n   rule: placeholders are not installed or exported\n   fix: wait for ${_ostia_rfc_${c}}, or drop '${c}' from COMPONENTS\n   see: RFC-0001 §3.1")
    return()
  endif()
  if(NOT c IN_LIST _ostia_real)
    list(JOIN _ostia_real ", " _ostia_real_text)
    set(ostia_FOUND FALSE)
    set(ostia_NOT_FOUND_MESSAGE " error: unknown ostia component '${c}'\n   components: ${_ostia_real_text}\n   fix: use one of the listed components\n   see: RFC-0001 §3.2")
    return()
  endif()
  if(NOT EXISTS "${CMAKE_CURRENT_LIST_DIR}/ostia-${c}-targets.cmake")
    string(TOUPPER ${c} _ostia_upper)
    set(ostia_FOUND FALSE)
    set(ostia_NOT_FOUND_MESSAGE " error: ostia component '${c}' is not installed in this prefix\n   prefix: ${PACKAGE_PREFIX_DIR}\n   fix: build it with -DOSTIA_BUILD_${_ostia_upper}=ON and install again\n   see: RFC-0001 §3.2")
    return()
  endif()
  _ostia_load(${c})
  set(ostia_${c}_FOUND TRUE)
endforeach()
check_required_components(ostia)
