  "$id": "ostia-topology-meta",
  "title": "meta.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "provider": {
      "type": "string"
    },
    "instance_type": {
      "type": "string"
    },
    "driver_version": {
      "type": "string"
